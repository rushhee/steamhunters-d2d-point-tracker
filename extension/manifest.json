{
  "manifest_version": 3,
  "name": "SteamHunters D2D Point Tracker",
  "version": "0.4.0",
  "description": "Shows which games on your profile went up or down in Steam Hunters points day to day.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": [
    "https://steamhunters.com/api/*",
    "https://steamcommunity.com/id/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://steamhunters.com/id/*", "https://steamhunters.com/profiles/*"],
      "js": ["render.js", "report-view.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
